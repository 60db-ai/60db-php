{
    "name": "sixtydb/sdk",
    "description": "Official PHP SDK for the 60db API (TTS, STT, chat, memory, voices).",
    "type": "library",
    "license": "MIT",
    "keywords": ["60db", "tts", "stt", "speech", "sdk"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "SixtyDB\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "SixtyDB\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test-live": "phpunit --testsuite live"
    },
    "config": { "sort-packages": true }
}
